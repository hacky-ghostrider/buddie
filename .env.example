# Application
APP_NAME=rag-evaluation-platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# API
API_PREFIX=/api/v1

# Document ingestion (Sprint 2)
SUPPORTED_DOCUMENT_TYPES=.pdf

# Chunking (Sprint 3)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEPARATORS=["\n\n", "\n", " ", ""]

# Embeddings (Sprint 4)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true

# Vector store (Sprint 5)
VECTOR_DB=chroma
# On Windows without hnswlib, the API auto-falls back to a JSON file store.
# Set VECTOR_DB=json to force that path. Use chroma on Linux/Docker.
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Retrieval (Sprint 6)
TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.0

# Generation (Sprint 7)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=1024
OPENAI_TIMEOUT_SECONDS=60

# DeepEval LLM judge (Buddie evals) — Gemini via DeepEval GeminiModel
# GOOGLE_API_KEY is the canonical variable. GEMINI_API_KEY is accepted as a
# legacy alias when GOOGLE_API_KEY is unset (it is not kept in the process env).
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# Gemini free-tier retry handling for Buddie eval LLM metrics
EVAL_GEMINI_MAX_RETRIES=3
EVAL_GEMINI_RETRY_DELAY_SEC=5.0

# RAG orchestration (Sprint 8)
MAX_CONTEXT_TOKENS=8000
PROMPT_TEMPLATE_DIRECTORY=prompts/templates
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_SCORE_THRESHOLD=0.0

# Evaluation framework (Sprint 9)
ENABLE_EVALUATION=true
DEFAULT_PASS_THRESHOLD=0.7
METRIC_TIMEOUT=30

# AI Evaluation Automation (Sprint 10)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-evaluation
ENABLE_LANGSMITH=false
ENABLE_DEEPEVAL=true
ENABLE_TOOL_VALIDATION=true
REPORT_DIRECTORY=./data/reports
BENCHMARK_DIRECTORY=./data/benchmarks
GOLDEN_DATASET_PATH=./datasets/golden_dataset.json
INPUT_TOKEN_COST_PER_1K=0.00015
OUTPUT_TOKEN_COST_PER_1K=0.0006

# Continuous AI Evaluation / Quality Gates (Sprint 12)
QUALITY_GATE_ENABLED=true
MIN_FAITHFULNESS=0.7
MAX_HALLUCINATION=0.3
MIN_RELEVANCY=0.7
MIN_CONTEXT_PRECISION=0.6
MIN_CONTEXT_RECALL=0.6
MAX_TOOL_FAILURES=0
MAX_TOOL_LATENCY=60000
MAX_TOTAL_LATENCY=120000
MAX_COST=1.0
PASS_THRESHOLD=0.7
WARNING_THRESHOLD=0.6
BENCHMARK_HISTORY_PATH=./data/benchmarks/history.json
QUALITY_REPORT_DIRECTORY=./data/quality_reports

# Streamlit chatbot UI (presentation layer only — no secrets here)
# OPENAI_API_KEY / LANGSMITH_API_KEY stay on the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=120
STREAMLIT_PORT=8501
STREAMLIT_PAGE_TITLE=Buddie
STREAMLIT_PAGE_ICON=:material/smart_toy:

# Sprint 15/16 — MCP tool mode (Direct remains default)
BUDDIE_TOOL_MODE=direct
MCP_TRANSPORT=memory
# Docker MCP HTTP example:
# BUDDIE_TOOL_MODE=mcp
# MCP_TRANSPORT=http
# MCP_SERVER_URL=http://mcp-server:8100/mcp
MCP_SERVER_URL=
MCP_SERVER_COMMAND=python -m app.mcp
MCP_TIMEOUT_SECONDS=30
# Optional FastMCP bind / DNS allow-list for container HTTP
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8100
# MCP_ALLOWED_HOSTS=mcp-server:*
